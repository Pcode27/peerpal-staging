{
  "name": "PeerPal-backend",
  "version": "1.0.0",
  "description": "PeerPal mental health support platform — backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/run.js",
    "migrate:check": "node migrations/run.js --check",
    "test:ai": "node --test src/backend/ai/*.test.js",
    "test:ledger": "node --test tests/creditLedger.test.js tests/trialExpiry.test.js tests/paymentWebhook.test.js",
    "test:push": "node --test tests/peerRequestPush.test.js",
    "test:referrals": "node --test tests/referrals.test.js",
    "test:pricing": "node --test tests/pricingService.test.js",
    "test:clients": "node --test tests/therapistClients.test.js",
    "test:phase54": "node --test tests/phase54Verify.test.js",
    "test:trusted-contacts": "node --test tests/trustedContacts.test.js",
    "test:migrations": "node --test tests/migrationRunner.test.js",
    "test:admin": "node --test tests/adminGrantPeer.test.js"
  },
  "engines": {
    "node": ">=20.20.0"
  },
  "dependencies": {
    "@posthog/ai": "^8.13.6",
    "@sentry/node": "^10.53.1",
    "@supabase/supabase-js": "^2.117.2",
    "@upstash/redis": "^1.37.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.76.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.1.0",
    "groq-sdk": "^0.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "openai": "^6.49.0",
    "opossum": "^10.0.0",
    "pg": "^8.11.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "posthog-node": "^5.56.0",
    "resend": "^6.12.2",
    "sharp": "^0.35.5",
    "uuid": "^9.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
